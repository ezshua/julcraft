# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# sqlite
*.db

# uploads (реальные загрузки; SVG-заглушки комплектующих — часть репозитория)
public/uploads/


# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# предзадачный слепок боевой БД (plan-snapshot Шаг 0)
*.db.pre-snapshot-task
