# SQLite (путь относительно корня site/)
DATABASE_URL=file:./julcraft.db

# --- Публичный адрес сайта (metadataBase, OG-теги, sitemap.xml) ---
# В dev можно не задавать (fallback http://localhost:3000); при деплое — реальный домен.
SITE_URL=

# --- Авторизация панели мастера (D-12: один аккаунт из env, не из кода) ---
# Логин/пароль и AUTH_SECRET обязательны для /admin и /api/admin/*.
# Сгенерировать секрет: AUTH_SECRET=$(openssl rand -base64 32)
ADMIN_LOGIN=
ADMIN_PASSWORD=

AUTH_SECRET=$(openssl rand -base64 32)
AUTH_TRUST_HOST=true
# реальный адрес, на котором висит сервер
AUTH_URL=http://localhost:3000

# --- Telegram-уведомления (Q-4; значения впишет руководитель) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

