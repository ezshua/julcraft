# SQLite (путь относительно корня site/)
DATABASE_URL=file:./julcraft.db

# --- Публичный адрес сайта (metadataBase, OG-теги, sitemap.xml) ---
# В dev можно не задавать (fallback http://localhost:3000); при деплое — реальный домен.
SITE_URL=

# --- Авторизация панели мастера (D-12: один аккаунт из env, не из кода) ---
# Логин/пароль и AUTH_SECRET обязательны для /admin и /api/admin/*.
# Сгенерировать секрет: AUTH_SECRET=$(openssl rand -base64 32)
ADMIN_LOGIN=
ADMIN_PASSWORD=

AUTH_SECRET=$(openssl rand -base64 32)
AUTH_TRUST_HOST=true
# реальный адрес, на котором висит сервер
AUTH_URL=http://localhost:3000

# --- Telegram-уведомления (Q-4; значения впишет руководитель) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Дефолты пользовательских настроек ---
# Выборы хранятся только в cookies: julcraft-skin, julcraft-currency, julcraft-locale.
# При смене DEFAULT_COOKIESID следующий HTTP-запрос сбрасывает весь набор на defaults
# и записывает новую версию. Значение — целое неотрицательное число; после изменения
# перезапустите сервер.
DEFAULT_COOKIESID=1
# DEFAULT_SKIN=memphis|handmade — стартовый скин («Мемфис» / «Тёплый»)
# DEFAULT_CURRENCY=USD|UAH|EUR|... — .env перекрывает Settings (если задан и есть в списке валют)
# DEFAULT_LOCALE=ru|en|uk — стартовый язык (cookie клиента приоритетнее)
DEFAULT_SKIN=memphis
# DEFAULT_CURRENCY=
# DEFAULT_LOCALE=ru

